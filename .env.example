# ──────────────────────────────────────────────────────────
# Lalla Fatema — environment variables
# Copy to `.env` for local dev. In production these live ONLY in Vercel env.
# ──────────────────────────────────────────────────────────

# Neon Postgres connection string (Payload owns the schema).
# Local dev uses the Neon `preview`/`dev` branch; prod uses `main`.
# Use sslmode=verify-full (require/prefer/verify-ca are accepted but the config
# upgrades them to verify-full to avoid the pg-connection-string deprecation warning).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# Payload encryption secret (generate a long random string).
PAYLOAD_SECRET=

# Public site URL (used for canonical URLs, sitemaps, preview).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Phase 1: Media (Cloudflare R2 + Image Transformations) ──
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
# Cloudflare image hostname for the custom next/image loader, e.g. images.lallafatema.ma
# NEXT_PUBLIC_IMAGE_HOST=

# ── Phase 3: secret-protected on-demand revalidation ──
# REVALIDATE_SECRET=

# ── Scheduled publishing: the /publish-due cron ──
# Set this in the Vercel project and Vercel will send it as `Authorization: Bearer …`
# on its own cron invocations of /publish-due (vercel.json), which is what makes a
# programmed article appear at its exact minute and reach the search index. Without it
# the feature still WORKS — the article becomes readable on its own — but surfaces at the
# next ISR expiry instead (up to an hour) and waits for its next edit to be searchable.
# REVALIDATE_SECRET also opens the endpoint manually: /publish-due?secret=…&minutes=1440
# CRON_SECRET=

# ── Homepage video band: the /sync-youtube cron ──
# The band and the /videos listing mirror the Lalla Fatema YouTube channel. The sync needs
# NO configuration to work: the channel id is built in (src/lib/youtube.ts) and the public
# RSS feed needs no credentials. Both variables below are optional.
#
# CRON_SECRET (above) is what lets Vercel's scheduler call /sync-youtube every 30 minutes
# (vercel.json). Without it the sync never runs on its own and the band freezes at whatever
# the last manual run left — so it matters more here than it does for scheduled publishing,
# where articles still surface at the next ISR expiry on their own.
# Trigger a sync by hand with: /sync-youtube?secret=$REVALIDATE_SECRET
#
# Override the channel (otherwise UCgJShJYlHW79y-ETvEqTI9w, "LALLA FATEMA TV لالة فاطمة").
# Must be a channel ID or a youtube.com/channel/<id> URL — an @handle cannot be resolved
# offline and is rejected, falling back to the built-in default.
# YOUTUBE_CHANNEL_ID=
#
# OPTIONAL upgrade. With no key the sync reads the public RSS feed, which carries only the
# latest 15 uploads — so the archive starts small and grows as the channel posts. Set a
# YouTube Data API v3 key and the sync instead walks the channel's uploads playlist, which
# backfills the whole back catalogue on the next run and adds real durations. No code
# change is needed; the sync picks the API up automatically when this is present.
# YOUTUBE_API_KEY=

# ── Phase 6: integrations (filled in at their phase) ──
# Search (Meilisearch): set BOTH to enable /search; unset ⇒ search runs inert.
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=
# Newsletter (Brevo double opt-in): set ALL THREE to enable the footer signup.
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# Web push (OneSignal): set the PUBLIC app id (+ optional Safari web id) to enable — these
# are inlined at BUILD time, so rebuild after setting. REST key is only for SENDING (unused
# by the subscription widget; reserved).
# NEXT_PUBLIC_ONESIGNAL_APP_ID=
# NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=
# ONESIGNAL_REST_API_KEY=

# ── Phase 8.4: Observability (filled in at cutover) ──
# Sentry — set the DSNs to enable error/perf reporting; unset ⇒ Sentry is fully inert.
# NEXT_PUBLIC_SENTRY_DSN is inlined at BUILD time, so rebuild after setting it.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (optional, build-time): set all three for readable stack traces.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Health check — set to enable the secret-gated deep DB readiness probe; unset ⇒ liveness only.
# HEALTHCHECK_SECRET=
